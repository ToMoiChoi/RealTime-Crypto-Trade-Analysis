# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=payment_events_v3

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=binance_dw
POSTGRES_USER=binance
POSTGRES_PASSWORD=binance123

# BigQuery Configuration (Optional - leave empty to skip)
BQ_PROJECT_ID=
BQ_DATASET=binance_dw
GOOGLE_APPLICATION_CREDENTIALS=

# Spark Configuration
SPARK_TRIGGER_INTERVAL=200 milliseconds
BQ_PARQUET_BACKUP_DIR=bq_backup
BQ_DLQ_DIR=dlq_bq_failed

# Live Producer Configuration
MAX_RETRIES=10
RETRY_INTERVAL_SEC=5

# Alerting Configurations (Optional)
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
ALERT_MAX_DLQ_FILES=20
ALERT_MIN_DISK_FREE_PERCENT=10.0

