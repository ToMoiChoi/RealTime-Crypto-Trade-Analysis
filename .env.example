# =====================================================================
# Configuration Template - Real-Time Crypto Streaming Pipeline
# =====================================================================
# Copy this file to .env and fill in your actual credentials:
# cp .env.example .env

# --- Apache Kafka Configuration ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=payment_events_v3

# --- PostgreSQL Configuration (Primary Hot DW) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=binance_dw
POSTGRES_USER=binance
POSTGRES_PASSWORD=binance123

# --- Google BigQuery Configuration (Backup Cold DW) ---
# Leave BQ_PROJECT_ID empty if running without GCP BigQuery
BQ_PROJECT_ID=your-gcp-project-id
BQ_DATASET=binance_dw
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json

# --- Apache Spark Processing Configuration ---
SPARK_TRIGGER_INTERVAL=200 milliseconds
BQ_PARQUET_BACKUP_DIR=bq_backup
BQ_DLQ_DIR=dlq_bq_failed

# --- Binance Live Ingestion Configuration ---
MAX_RETRIES=10
RETRY_INTERVAL_SEC=5

# --- Telegram & Discord Alerting (Optional) ---
ALERT_TELEGRAM_TOKEN=your_telegram_bot_token_here
ALERT_TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ALERT_DISCORD_WEBHOOK_URL=
ALERT_MAX_DLQ_FILES=20
ALERT_MIN_DISK_FREE_PERCENT=10.0
